# ───────────────────────────────
# Application
# ───────────────────────────────
APP_NAME=adam-auth
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ───────────────────────────────
# Database (PostgreSQL)
# ───────────────────────────────
DB_USER=admin
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adam_db
DB_SSLMODE=disable

# ───────────────────────────────
# JWT Configuration
# ───────────────────────────────
JWT_SECRET_ACCESS=your-256-bit-access-secret-key-change-in-production
JWT_SECRET_REFRESH=your-256-bit-refresh-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=24h
JWT_COOKIE_SECURE=false

# ───────────────────────────────
# Password & Security
# ───────────────────────────────
PASSWORD_HASH_COST=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080